# Copy to .env.local and fill in. Do NOT commit .env.local.
#
# Firebase web app config — get from:
#   https://console.firebase.google.com/project/automated-reporting-498515/settings/general
#   → "Your apps" → Web app → SDK setup and configuration → Config
#
# If no web app exists yet, click "Add app" → Web, register, then copy values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=automated-reporting-498515.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=automated-reporting-498515
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API base. For local dev leave the default; for production set to the
# Cloud Run service URL (e.g. https://antigravity-api-xxxxx-uc.a.run.app).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
