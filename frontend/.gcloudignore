tsconfig.tsbuildinfo

# Editor / OS
.DS_Store
.vscode/
.idea/

# Env files. Production builds take their NEXT_PUBLIC_* values from the
# committed .env.production, so that file MUST reach the build context.
#
# .env.local is deliberately excluded: it is a developer's local config and
# Next.js gives it precedence over .env.production, so shipping it would let a
# local `NEXT_PUBLIC_API_BASE_URL=http://localhost:8000` override the real API
# URL and produce a bundle that calls the visitor's own machine.
.env.local
.env.local.example
.env.development
