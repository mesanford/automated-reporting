# Production build values, inlined into the client bundle by `next build`.
#
# This file is committed on purpose. Every value here is a NEXT_PUBLIC_*
# value that ships to browsers in the bundle anyway — the Firebase web config
# is public by design (access is governed by Firebase security rules and the
# backend's token verification, not by hiding these). Nothing secret goes here.
#
# It exists because the deploy previously relied on `.env.local` reaching the
# Cloud Build context. That file is a developer's local config, so whenever it
# pointed at localhost — its normal state — a frontend deploy would silently
# ship a bundle whose API calls went to the visitor's own machine. `.env.local`
# is now excluded from the build context (see .gcloudignore) and these values
# are what production builds with.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB3DrM3ShAcN2CQmnwW8D57Jbaz-AUbaZ0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=automated-reporting-498515.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=automated-reporting-498515
NEXT_PUBLIC_FIREBASE_APP_ID=1:624805225254:web:7bc360467b3d181625d7e7

NEXT_PUBLIC_API_BASE_URL=https://antigravity-api-624805225254.us-central1.run.app
